# Local example. Staging requires APP_ENV=staging, an exact HTTPS
# APP_ORIGIN, and the matching explicit SUPABASE_PROJECT_REF/URL.
APP_ENV=local
APP_ORIGIN=http://127.0.0.1:3001
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PROJECT_REF=
SUPABASE_PUBLISHABLE_KEY=
# Closed by default. Open only for a supervised, time-limited exact-operator setup.
ADMIN_MFA_ENROLLMENT_ENABLED=false
ADMIN_MFA_ENROLLMENT_SUBJECT=
ADMIN_MFA_ENROLLMENT_EXPIRES_AT=
# Never use a service-role/secret key here.
