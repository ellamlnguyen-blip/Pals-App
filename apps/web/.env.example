# Copy to apps/web/.env.local. Use the publishable (or legacy anon) key from local status.
# APP_ENV is separate from NODE_ENV, and defaults to local.
APP_ENV=local
APP_ORIGIN=http://127.0.0.1:3000
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=
# Hosted environments require all three explicit values plus an HTTPS APP_ORIGIN:
# APP_ENV=staging
# SUPABASE_PROJECT_REF=<20-character-reference>
# SUPABASE_URL=https://<20-character-reference>.supabase.co
# Never use a service-role/secret key. All provider calls use user sessions and RLS.
