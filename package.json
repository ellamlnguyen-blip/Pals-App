{
  "name": "pals",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @pals/web --filter @pals/admin dev",
    "dev:web": "pnpm --filter @pals/web dev",
    "dev:admin": "pnpm --filter @pals/admin dev",
    "build": "pnpm --filter @pals/web --filter @pals/admin build",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "node --test tests/*.test.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@types/node": "24.13.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.1",
    "eslint-config-next": "16.3.5",
    "prettier": "3.9.8",
    "typescript": "5.9.3"
  }
}
