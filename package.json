{
  "name": "pals",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @pals/web --filter @pals/admin dev",
    "dev:web": "pnpm --filter @pals/web dev",
    "dev:admin": "pnpm --filter @pals/admin dev",
    "build": "pnpm --filter @pals/web --filter @pals/admin build",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "node --test tests/*.test.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "db:start": "supabase start --network-id pals-local-network",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset --local",
    "db:test": "supabase test db --local",
    "db:lint": "supabase db lint --local --schema public,private --level warning --fail-on warning",
    "db:verify": "pnpm db:reset && pnpm db:test && pnpm db:reset && pnpm db:test && pnpm db:lint"
  },
  "devDependencies": {
    "@types/node": "24.13.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.1",
    "eslint-config-next": "16.3.5",
    "prettier": "3.9.8",
    "supabase": "2.117.0",
    "typescript": "5.9.3"
  }
}
